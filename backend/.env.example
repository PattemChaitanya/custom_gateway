# =============================================================================
# Gateway Management — Environment Variables Reference
# =============================================================================
# Copy this file to `.env` and fill in all REQUIRED values before running.
# REQUIRED vars cause the server to refuse to start if unset.
# OPTIONAL vars have safe defaults that work for local development.
# NEVER commit a populated .env file to source control.
# =============================================================================


# -----------------------------------------------------------------------------
# Database  [REQUIRED — at least one of DATABASE_URL or AWS_DB_* must be set]
# -----------------------------------------------------------------------------

# Primary database URL. Supports PostgreSQL (production) and SQLite (dev/test).
# PostgreSQL (production):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# SQLite (local dev only — not for production):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Emit SQLAlchemy SQL statements to the log. Set to "true" only for debugging.
# OPTIONAL | default: False
SQL_ECHO=False


# -----------------------------------------------------------------------------
# Authentication & Security  [ALL REQUIRED IN PRODUCTION]
# -----------------------------------------------------------------------------

# Master secret used to sign JWT access tokens and derive the encryption key.
# REQUIRED | no default — server refuses to start if unset
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Secret used to sign JWT refresh tokens (separate from access token secret).
# REQUIRED | no default
REFRESH_TOKEN_SALT=

# Secret used to sign gateway-issued JWT tokens in API auth policies.
# REQUIRED | no default — pipeline returns 500 if unset when JWT auth is used
JWT_SECRET=

# JWT signing algorithm for access tokens.
# OPTIONAL | default: HS256
JWT_ALGORITHM=HS256

# Salt used to derive the Fernet encryption key from SECRET_KEY when
# ENCRYPTION_KEY is not explicitly set. Change from the default before deploy.
# OPTIONAL | default: gateway-encryption-salt
ENCRYPTION_SALT=

# Pre-derived Fernet encryption key (base64url, 32-byte). When set, overrides
# the derived key. Useful for key rotation without changing SECRET_KEY.
# OPTIONAL | derived from SECRET_KEY + ENCRYPTION_SALT when unset
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Redis  [OPTIONAL — rate limiting degrades gracefully without Redis]
# -----------------------------------------------------------------------------

# Redis connection URL. Used by all three rate limiting algorithms.
# Without Redis, the gateway fails-open (all requests allowed) with a warning.
# OPTIONAL | default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis password (if your Redis instance requires AUTH).
# OPTIONAL | default: (none)
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Global rate limit applied to all gateway traffic (requests per window).
# OPTIONAL | default: 1000
GLOBAL_RATE_LIMIT=1000

# Global rate limit window in seconds.
# OPTIONAL | default: 60
GLOBAL_RATE_LIMIT_WINDOW=60

# Stricter rate limit applied to management API endpoints (/apis, /keys, /secrets).
# OPTIONAL | default: 100
MGMT_RATE_LIMIT=100

# Management API rate limit window in seconds.
# OPTIONAL | default: 60
MGMT_RATE_LIMIT_WINDOW=60


# -----------------------------------------------------------------------------
# Circuit Breaker
# -----------------------------------------------------------------------------

# Number of consecutive upstream connection failures before opening the circuit.
# OPTIONAL | default: 5
CIRCUIT_FAILURE_THRESHOLD=5

# Seconds to wait in OPEN state before attempting a recovery probe (HALF-OPEN).
# OPTIONAL | default: 30
CIRCUIT_RECOVERY_TIMEOUT=30


# -----------------------------------------------------------------------------
# Gateway Proxy
# -----------------------------------------------------------------------------

# Global maximum request body size in bytes (applies to all APIs).
# Individual APIs can override this via api.config.max_body_size.
# OPTIONAL | default: 10485760 (10 MB)
MAX_BODY_SIZE=10485760


# -----------------------------------------------------------------------------
# Audit Log Retention
# -----------------------------------------------------------------------------

# Automatically delete audit log rows older than this many days.
# Set to 0 to disable automatic purging entirely.
# OPTIONAL | default: 90
AUDIT_LOG_RETENTION_DAYS=90

# How often the background retention loop runs (in hours).
# OPTIONAL | default: 24
AUDIT_LOG_PURGE_INTERVAL_HOURS=24


# -----------------------------------------------------------------------------
# Control Plane
# -----------------------------------------------------------------------------

# Interval in seconds between mini-cloud control loop ticks.
# OPTIONAL | default: 5
CONTROL_LOOP_INTERVAL_SECONDS=5


# -----------------------------------------------------------------------------
# AWS RDS / PostgreSQL (alternative to DATABASE_URL)
# -----------------------------------------------------------------------------
# When DATABASE_URL is not set, the app builds a PostgreSQL URL from these.
# Leave all blank if you are using DATABASE_URL directly.

# OPTIONAL | example: database-1.xxxx.ap-south-1.rds.amazonaws.com
AWS_DB_HOST=

# OPTIONAL | default: postgres
AWS_DB_NAME=postgres

# OPTIONAL | example: postgres
AWS_DB_USER=

# OPTIONAL (but required for AWS connectivity)
AWS_DB_PASSWORD=

# OPTIONAL | default: 5432
AWS_DB_PORT=5432

# OPTIONAL | values: disable | allow | prefer | require | verify-ca | verify-full
AWS_REQUIRE_SSL=require

# OPTIONAL | path to RDS CA bundle (leave blank unless downloaded)
AWS_DB_SSL_FILE_PATH=
AWS_SSLROOTCERT=

